function Help_Lydz() {
    init_language_strings
    
    if [[ "$LANG" == "en" ]]; then
cat << 'EOF'
Version：1.36
Usage：Install_Lyz.bin [options]

Options：
     --no_simc     Skip background music
     --no-verify     Skip SHA256 verification
     --version     Check version
     --remove     Uninstall Kali NetHunter
     --lang [en/zh]     Set interface language (English/Chinese)
     --help     Show this help message
    
Feedback：
    Github：https://github.com/AliteIz/Kali_NetHunter_Termux
    Email：montebaursascha930@gmail.com lyz_ydz_xz@outlook.com
EOF
    else
cat << 'EOF'
版本：1.36
用法：Install_Lyz.bin [选项]

选项：
     --no_simc     跳过背景音乐
     --no-verify     跳过SHA256验证
     --version     检查版本
     --remove     卸载Kali NetHunter
     --lang [en/zh]     设置界面语言（英文/中文）
     --help     显示此帮助信息
    
反馈：
    Github：https://github.com/AliteIz/Kali_NetHunter_Termux
    邮箱：montebaursascha930@gmail.com lyz_ydz_xz@outlook.com
EOF
    fi
}


function main() {
    init_language_strings
    
    trap 'lydz' EXIT
    trap 'lydz; exit 1' INT TERM
    check_termux_environment
    cd "$HOME"
    
    mkdir -p "${HOME}/simc"
    print_banner
    check_update
    get_arch
    setup_termux_storage
    lzf
    set_strings
    prepare_fs
    get_rootfs
    verify_sha
    extract_rootfs
    create_launcher
    cleanup
    
    log "INFO" "${STR_CONFIGURING}"
    fix_profile_bash
    fix_resolv_conf
    fix_sudo
    create_kex_launcher
    fix_uid
    update_sources_list
    
    if [ -d "/data/data/com.termux/files/home/simc" ]; then
         rm -rf "/data/data/com.termux/files/home/simc"
    fi
    
    sleep 3
    
    print_banner
    log "SUCCESS" "${STR_INSTALL_COMPLETE}"
    
    echo
    printf "${green}${USAGE_TITLE}${reset}\n"
    printf "${green}${USAGE_NETHUNTER}${reset}\n"
    printf "${green}${USAGE_NH}${reset}\n"
    printf "${green}${USAGE_EXIT}${reset}\n\n"
    
    printf "${green}${KEX_TITLE}${reset}\n"
    printf "${green}${KEX_PASSWD}${reset}\n"
    printf "${green}${KEX_START}${reset}\n"
    printf "${green}${KEX_STOP}${reset}\n"
    printf "${green}${KEX_STATUS}${reset}\n\n"
    
    printf "${green}${ADVANCED_TITLE}${reset}\n"
    printf "${green}${ADVANCED_ROOT}${reset}\n"
    printf "${green}${ADVANCED_KILL}${reset}\n"
    echo
}


while [[ $# -gt 0 ]]; do
    case $1 in
        --no_simc)
            no_simc=false
            shift
            ;;
        --remove)
            init_language_strings
            cd "$HOME"
            rm -rf kali-*/
            rm -rf /data/data/com.termux/files/usr/bin/nethunter
            shift
            exit 0
            ;;
        --no-verify)
            no_verify=true
            shift
            ;;
        --lang)
            if [[ -z "$2" ]] || [[ ! "$2" =~ ^(en|zh)$ ]]; then
                init_language_strings
                if [[ "${LANG}" == "en" ]]; then
                    echo "ERROR：--lang requires 'en' or 'zh'" >&2
                else
                    echo "错误：--lang 参数需要 'en' 或 'zh'" >&2
                fi
                exit 1
            fi
            LANG="$2"
            shift 2
            ;;
        --help)
            init_language_strings
            Help_Lydz
            exit 0
            ;;
        --version)
            init_language_strings
            echo "Kali NetHunter Installer v${VERSION}"
            exit 0
            ;;
        *)
            init_language_strings
            if [[ "${LANG}" == "en" ]]; then
                echo "ERROR：Unknown option：$1" >&2
                echo "Try '--help' for usage information." >&2
            else
                echo "错误：未知选项：$1" >&2
                echo "请使用 '--help' 查看帮助信息。" >&2
            fi
            exit 1
            ;;
    esac
done


main "$@"