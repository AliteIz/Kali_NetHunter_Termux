#!/data/data/com.termux/files/usr/bin/bash -e

set -euo pipefail

# This script is only for legal, authorized security testing and educational purposes
# Prohibited for any illegal attack behavior
# Users must comply with local laws and regulations


red='\033[1;31m'
green='\033[1;32m'
yellow='\033[1;33m'
blue='\033[1;34m'
light_cyan='\033[1;96m'
reset='\033[0m'

blue_bg='\033[1;44m'
yellow_bg='\033[1;43m'
red_bg='\033[1;41m'
green_bg='\033[1;42m'

blue_fg_strong='\033[1;34m'
yellow_fg_strong='\033[1;33m'
red_fg_strong='\033[1;31m'
green_fg_strong='\033[1;32m'


LANG="${LANG:-zh}"


SUTIN="Lyz_ydz_"
JSZC="Deepseek Gemini Grok"
VERSION="1.36"
BASE_URL="https://kali.download/nethunter-images/current/rootfs"
VERSION_URL="https://raw.githubusercontent.com/AliteIz/Kali_NetHunter_Termux/main/ersi"
USERNAME="kali"


MUSIC_PID=""
MUSIC_URLS=(
    "https://github.com/AliteIz/Kali_NetHunter_Termux/raw/main/simc/a.mp3"
    "https://github.com/AliteIz/Kali_NetHunter_Termux/raw/main/simc/b.mp3"
)
MUSIC_FILES=(
    "${HOME}/simc/a.mp3"
    "${HOME}/simc/b.mp3"
)
MUSIC_STARTED="0"
MUSIC_INDEX=0
MUSIC_LOOP_SCRIPT=""
MUSIC_PLAYLIST=""


function log() {
    current_time=$(date +'%Y-%m-%d %H:%M:%S')
    
    case "$1" in
        "INFO")
            echo -e "${blue_bg}{$SUTIN}[$current_time]${reset} ${blue_fg_strong}[${STR_INFO}]${reset} $2"
            ;;
        "WARN")
            echo -e "${yellow_bg}{$SUTIN}[$current_time]${reset} ${yellow_fg_strong}[${STR_WARNING}]${reset} $2"
            ;;
        "ERROR")
            echo -e "${red_bg}{$SUTIN}[$current_time]${reset} ${red_fg_strong}[${STR_ERROR}]${reset} $2"
            ;;
        "SUCCESS")
            echo -e "${green_bg}{$SUTIN}[$current_time]${reset} ${green_fg_strong}[${STR_SUCCESS}]${reset} $2"
            ;;
        *)
            echo -e "${blue_bg}{$SUTIN}[$current_time]${reset} ${blue_fg_strong}[${STR_DEBUG}]${reset} $2"
            ;;
    esac
}


function check_termux_environment() {
    if ! command -v termux-info &>/dev/null; then
        log "ERROR" "${STR_TERMUX_ONLY}"
        exit 1
    fi
}


function setup_termux_storage() {
    local STORAGE_DIR="/data/data/com.termux/files/home/storage"
    local SHARED_DIR="$STORAGE_DIR/shared"
    
    if [ ! -d "$SHARED_DIR" ] || [ -z "$(ls -A "$SHARED_DIR" 2>/dev/null)" ]; then
        log "INFO" "${STR_STORAGE_PERMISSION}"
        if termux-setup-storage; then
            log "SUCCESS" "${STR_STORAGE_SUCCESS}"
            return 0
        else
            log "ERROR" "${STR_STORAGE_FAILED}"
            return 1
        fi
    else
        log "INFO" "${STR_STORAGE_SKIP}"
        return 0
    fi
}



function lzf() {
    if [ "${no_simc:-true}" = "false" ]; then
       log "INFO" "${STR_SKIP_MUSIC}"
       return 0
    fi
    
    if ! command_exists ffplay; then
        log "WARN" "${STR_FFPLAY_INSTALL_FAILED}"
        return 0
    fi
    
    local download_failed=0
    for i in "${!MUSIC_URLS[@]}"; do
        if [ ! -f "${MUSIC_FILES[$i]}" ]; then
            log "INFO" "$(printf "${STR_DOWNLOADING_MUSIC}" "$((i+1))" "$(basename "${MUSIC_FILES[$i]}")")"
            if command_exists wget; then
                if ! wget -c -q -O "${MUSIC_FILES[$i]}" "${MUSIC_URLS[$i]}"; then
                    log "WARN" "${STR_DOWN} ${MUSIC_URLS[$i]} ${STR_FAILED}"
                    download_failed=1
                fi
            else
                log "WARN" "${STR_WGET_NOT_FOUND}"
                download_failed=1
                break
            fi
        fi
    done
    
    if [ $download_failed -eq 1 ]; then
        log "WARN" "${STR_MUSIC_START_FAILED}"
        return 0
    fi
    
    for file in "${MUSIC_FILES[@]}"; do
        if [ ! -f "$file" ] || [ ! -s "$file" ]; then
            log "WARN" "${STR_MUSIC_FILE} $file ${STR_INVALID}"
            return 0
        fi
    done
    
    if ! start_music_loop_simple; then
        log "WARN" "${STR_MUSIC_START_FAILED}"
    fi
    
    return 0
}

function start_music_loop_simple() {
    local playlist="${HOME}/.music_playlist_$$.txt"
    
    > "$playlist"
    for file in "${MUSIC_FILES[@]}"; do
        echo "file '$file'" >> "$playlist"
    done
    
    nohup ffplay -nodisp -autoexit -loglevel quiet \
        -infbuf -noborder -nostats \
        -loop 0 \
        -f concat -safe 0 \
        -i "$playlist" \
        </dev/null >/dev/null 2>&1 &
    
    MUSIC_PID=$!
    MUSIC_PLAYLIST="$playlist"
    MUSIC_LOOP_SCRIPT=""
    
    sleep 1
    if kill -0 "$MUSIC_PID" 2>/dev/null; then
        log "INFO" "$(printf "${STR_MUSIC_STARTED_PLAYLIST}" "$MUSIC_PID")"
        MUSIC_STARTED=1
        return 0
    else
        log "WARN" "${STR_MUSIC_START_FAILED}"
        rm -rf "$playlist" 2>/dev/null || true
        MUSIC_PID=""
        MUSIC_PLAYLIST=""
        return 1
    fi
}
function start_music_loop_script() {
    local tmp_script="${HOME}/.music_loop_$$.sh"
    
    cat > "$tmp_script" << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash

MUSIC_FILES=(
EOF
    
    for file in "${MUSIC_FILES[@]}"; do
        echo "    \"$file\"" >> "$tmp_script"
    done
    echo ")" >> "$tmp_script"
    cat >> "$tmp_script" << 'EOF'
)
current_index=0
total_files=${#MUSIC_FILES[@]}

exec </dev/null >/dev/null 2>&1

play_loop() {
    while true; do
        ffplay -nodisp -autoexit -loglevel quiet \
            -infbuf -noborder -nostats \
            "${MUSIC_FILES[$current_index]}" \
            2>/dev/null
        
        current_index=$(( (current_index + 1) % total_files ))
        
        sleep 0.1
    done
}
play_loop
EOF

    chmod +x "$tmp_script"
    
    nohup "$tmp_script" >/dev/null 2>&1 &
    MUSIC_PID=$!
    MUSIC_LOOP_SCRIPT="$tmp_script"
    MUSIC_PLAYLIST=""
    
    sleep 2
    if kill -0 "$MUSIC_PID" 2>/dev/null; then
        log "INFO" "$(printf "${STR_MUSIC_STARTED_PLAYLIST}" "$MUSIC_PID")"
        MUSIC_STARTED=1
        return 0
    else
        log "WARN" "${STR_MUSIC_START_FAILED}"
        rm -rf "$tmp_script" 2>/dev/null || true
        MUSIC_PID=""
        MUSIC_LOOP_SCRIPT=""
        return 1
    fi
}


function lydz() {
    log "INFO" "${STR_MUSIC_STOPPING}"
    
    pkill -f "ffplay.*\.mp3" 2>/dev/null || true
    
    safe_kill "$MUSIC_PID"
    MUSIC_PID=""
    
    if [[ -n "$MUSIC_PLAYLIST" ]] && [[ -f "$MUSIC_PLAYLIST" ]]; then
        rm -rf "$MUSIC_PLAYLIST" 2>/dev/null || true
        MUSIC_PLAYLIST=""
    fi
    
    if [[ -n "$MUSIC_LOOP_SCRIPT" ]] && [[ -f "$MUSIC_LOOP_SCRIPT" ]]; then
        rm -rf "$MUSIC_LOOP_SCRIPT" 2>/dev/null || true
        MUSIC_LOOP_SCRIPT=""
    fi
    
    MUSIC_STARTED=0
    log "SUCCESS" "${STR_BACKGROUND_MUSIC_STOPPED}"
    return 0
}

function safe_kill() {
    local pid="$1"
    if [[ -n "$pid" ]]; then
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            sleep 0.2
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null || true
            fi
        fi
    fi
}


function check_update() {
    log "INFO" "$STR_CHECKING_UPDATE"
    local latest_version
    local local_ver="${VERSION#v}"
    local remote_ver
    
    if latest_version=$(curl -s --fail "$VERSION_URL" 2>/dev/null | tr -d '\n\r'); then
        remote_ver="${latest_version#v}"
        
        if [[ "$remote_ver" == "$local_ver" ]]; then
            log "SUCCESS" "$STR_ALREADY_LATEST (v$local_ver)"
        else
            log "SUCCESS" "$STR_NEW_VERSION_AVAILABLE：v$remote_ver ($STR_CURRENT_VERSION：v$local_ver)"
        fi
    fi
}


error_exit() {
    log "ERROR" "$1"
    lydz
    exit 1
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

function unsupported_arch() {
    error_exit "${STR_ARCH_UNSUPPORTED}$(getprop ro.product.cpu.abi)"
}


function ask() {
    while true; do
        if [ "${2:-}" = "Y" ]; then
            prompt="Y/n"
            default=Y
        elif [ "${2:-}" = "N" ]; then
            prompt="y/N"
            default=N
        else
            prompt="y/n"
            default=
        fi
        printf "${light_cyan}\n[?] "
        read -p "$1 [$prompt] " REPLY
        if [ -z "$REPLY" ]; then
            REPLY=$default
        fi
        printf "${reset}"
        case "$REPLY" in
            Y*|y*) return 0 ;;
            N*|n*) return 1 ;;
        esac
    done
}

function get_arch() {
    log "INFO" "${STR_ARCH_CHECKING}"
    case $(getprop ro.product.cpu.abi) in
        arm64-v8a)
            SYS_ARCH=arm64
            log "INFO" "${STR_ARCH_DETECTED}arm64"
            ;;
        armeabi|armeabi-v7a)
            SYS_ARCH=armhf
            log "INFO" "${STR_ARCH_DETECTED}armhf"
            ;;
        *)
            unsupported_arch
            ;;
    esac
}


function set_strings() {
    local menu_options=()
    local descriptions=()
    
    if [[ ${SYS_ARCH} == "arm64" ]]; then
        menu_options=("full" "minimal" "nano")
        descriptions=("Kali NetHunter arm64 (${STR_FVERSION} - 2.1 GiB)" "Kali NetHunter arm64 (${STR_CVERSION} - 131.6 MiB)" "Kali NetHunter arm64 (${STR_NVERSION} - 185.2 MiB)")
    elif [[ ${SYS_ARCH} == "armhf" ]]; then
        menu_options=("full" "minimal" "nano")
        descriptions=("Kali NetHunter armhf (${STR_FVERSION} - 2.0 GiB)" "Kali NetHunter armhf (${STR_CVERSION} - 122.2 MiB)" "Kali NetHunter armhf (${STR_NVERSION} - 174.2 MiB)")
    fi
    
    echo
    printf "${green}[a]${reset} %s\n" "${descriptions[0]}"
    printf "${green}[b]${reset} %s\n" "${descriptions[1]}"
    printf "${green}[c]${reset} %s\n" "${descriptions[2]}"
    echo
    
    while true; do
        read -r -p "${STR_CHOOSE_IMAGE}" choice
        choice=${choice:-a}
        
        if [[ "$choice" = "L" ]]; then
            log "INFO" "${STR_EXIT_SCRIPT}"
            exit 0
        fi
        
        case "$choice" in
            a)
                wimg="${menu_options[0]}"
                log "INFO" "${STR_IMAGE_SELECTED}${descriptions[0]}"
                break
                ;;
            b)
                wimg="${menu_options[1]}"
                log "INFO" "${STR_IMAGE_SELECTED}${descriptions[1]}"
                break
                ;;
            c)
                wimg="${menu_options[2]}"
                log "INFO" "${STR_IMAGE_SELECTED}${descriptions[2]}"
                break
                ;;
            *)
                log "WARN" "${STR_INVALID_OPTION} (a-c)"
                ;;
        esac
    done
    CHROOT=kali-${SYS_ARCH}
    IMAGE_NAME=kali-nethunter-rootfs-${wimg}-${SYS_ARCH}.tar.xz
}


function prepare_fs() {
    unset KEEP_CHROOT
    if [ -d "${CHROOT}" ]; then
        if ask "${STR_FOUND_EXISTING_DIR}" "N"; then
            log "INFO" "${STR_DELETING_EXISTING_DIR}"
            rm -rf "${CHROOT}" || error_exit "${STR_CANNOT_DELETE_DIR}"
        else
            KEEP_CHROOT=1
            log "INFO" "${STR_KEEP_EXISTING_DIR}"
        fi
    fi
}

function cleanup() {
    if [ -f "${IMAGE_NAME}" ]; then
        if ask "${STR_CONFIRM_DELETE_IMAGE}${IMAGE_NAME}？" "Y"; then
            log "INFO" "${STR_DELETING_DOWNLOADED_FILE}"
            rm -rf "${IMAGE_NAME}" || log "WARN" "${STR_CANNOT_DELETE_FILE}${IMAGE_NAME}"
        fi
    fi
}


function get_rootfs() {
    unset KEEP_IMAGE
    if [ -f "${IMAGE_NAME}" ]; then
        if ask "${STR_CONFIRM_DELETE_EXISTING}${IMAGE_NAME}${STR_CONFIRM_DELETE_EXISTING2}${STR_CONFIRM_DELETE_EXISTING3}" "N"; then
            rm -rf "${IMAGE_NAME}" || error_exit "${STR_DOWNLOAD_FAILED}"
        else
            log "INFO" "${STR_USE_EXISTING_FILE}"
            KEEP_IMAGE=1
            return
        fi
    fi
    
    log "INFO" "${STR_DOWNLOAD_START}"
    ROOTFS_URL="${BASE_URL}/${IMAGE_NAME}"
    
    if command_exists aria2c; then
        log "INFO" "${STR_DOWNLOAD_ARIA}${ROOTFS_URL}"
        if aria2c -q -x 16 -s 16 -k 1M "${ROOTFS_URL}"; then
            log "SUCCESS" "${STR_DOWNLOAD_COMPLETE}"
        else
            error_exit "${STR_DOWNLOAD_FAILED}"
        fi
    else
        error_exit "${STR_ARIA2C_NOT_FOUND}${ROOTFS_URL}"
    fi
    
    if [ ! -f "${IMAGE_NAME}" ]; then
        rm -rf ./kali-nethunter-rootfs-*.tar.xz
        rm -rf ./kali-nethunter-rootfs-*.tar.xz.*
        error_exit "${STR_FILE_NOT_EXIST}${IMAGE_NAME}${STR_FILE_NOT_EXIST2}"
    fi
}


function verify_sha() {
    if [ "${no_verify:-false}" = "true" ]; then
        log "INFO" "${STR_SKILP_VERIFY}"
        return 0
    fi
    
    log "INFO" "${STR_DOWNLOAD_VERIFY}"
    curl -s -o SHA256SUMS --connect-timeout 10 --max-time 10 "${BASE_URL}/SHA256SUMS"
    if [ -f "SHA256SUMS" ]; then
        EXPECTED_HASH=$(grep "${wimg}-${SYS_ARCH}\.tar\.xz$" SHA256SUMS | awk '{print $1}')
        rm -f SHA256SUMS
        if [ -z "$EXPECTED_HASH" ]; then
            error_exit "${STR_HASH_NOT_FOUND}"
        fi
        log "INFO" "${STR_COMPUTE_HASH}"
        ACTUAL_HASH=$(sha256sum "$IMAGE_NAME" | awk '{print $1}')
        if [ "$EXPECTED_HASH" = "$ACTUAL_HASH" ]; then
            log "SUCCESS" "${STR_VERIFY_SUCCESS}"
            return 0
        else
            error_exit "${STR_VERIFY_FAILED}"
            rm -f "$IMAGE_NAME"
        fi
    else
        log "WARN" "${STR_SKIP_VERIFY}"
        return 0
    fi
}


function extract_rootfs() {
    if [ -z "${KEEP_CHROOT:-}" ]; then
        log "INFO" "${STR_EXTRACT_START}"
        
        proot --link2symlink tar -xJf "$IMAGE_NAME" \
            --no-same-owner --no-same-permissions --exclude='dev/*' || {
            error_exit "${STR_EXTRACT_FAILED}"
        }
        
        log "SUCCESS" "${STR_EXTRACT_COMPLETE}"
    else
        log "INFO" "${STR_USING_EXISTING_DIR}"
    fi
}

function create_launcher() {
    log "INFO" "${STR_LAUNCHER_CREATE}"
    
    NH_LAUNCHER=${PREFIX}/bin/nethunter
    NH_SHORTCUT=${PREFIX}/bin/nh
    
    cat > "$NH_LAUNCHER" <<- EOF
#!/data/data/com.termux/files/usr/bin/bash -e
cd \${HOME}
unset LD_PRELOAD
if [ ! -f $CHROOT/root/.version ]; then
    touch $CHROOT/root/.version
fi
user="$USERNAME"
home="/home/\$user"
start="sudo -u kali /bin/bash"
if grep -q "kali" ${CHROOT}/etc/passwd; then
    KALIUSR="1";
else
    KALIUSR="0";
fi
if [[ \$KALIUSR == "0" || ("\$#" != "0" && ("\$1" == "-r" || "\$1" == "-R")) ]];then
    user="root"
    home="/\$user"
    start="/bin/bash --login"
    if [[ "\$#" != "0" && ("\$1" == "-r" || "\$1" == "-R") ]];then
        shift
    fi
fi
cmdline="proot \\
        --link2symlink \\
        --kill-on-exit \\
        --sysvipc \\
        -0 \\
        -k 6.12.23
        -r /data/data/com.termux/files/home/$CHROOT \\
        -b /apex \\
        -b /sys \\
        -b /vendor \\
        -b /acct \\
        -b /product \\
        -b /proc/self/fd/2:/dev/stderr \\
        -b /proc/self/fd/1:/dev/stdout \\
        -b /proc/self/fd/0:/dev/stdin \\
        -b /dev/null:/dev/tty0 \\
        -b /proc/self/fd:/dev/fd \\
        -b /dev/urandom:/dev/random \\
        -b /dev/null:/proc/sys/kernel/cap_last_cap \\
        -b /dev \\
        -b /proc \\
        -b /data/data/com.termux/files/usr/tmp:/tmp \\
        -b /data/local/tmp:/dev/shm \\
        -w \$home \\
           /usr/bin/env -i \\
           HOME=\$home \\
           PATH=/usr/local/sbin:/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin \\
           TERM=\$TERM \\
           LANGUAGE="zh_CN:zh" \\
           LANG="zh_CN.UTF-8" \\
           LC_ALL=zh_CN.UTF-8 \\
           \$start"
cmd="\$@"
if [ "\$#" == "0" ];then
    exec \$cmdline
else
    \$cmdline -c "\$cmd"
fi
EOF
    chmod 700 "$NH_LAUNCHER"
    
    if [ -L "${NH_SHORTCUT}" ]; then
        rm -rf "${NH_SHORTCUT}"
    fi
    if [ ! -f "${NH_SHORTCUT}" ]; then
        ln -s "${NH_LAUNCHER}" "${NH_SHORTCUT}" >/dev/null
    fi
    
    log "SUCCESS" "${STR_LAUNCHER_COMPLETE}"
}

function create_kex_launcher() {
    log "INFO" "${STR_KEX_CREATE}"
    KEX_LAUNCHER=${CHROOT}/usr/bin/kex
    cat > $KEX_LAUNCHER <<- EOF
#!/bin/bash
function start-kex() {
    export FONTCONFIG_PATH=/etc/fonts
    export FONTCONFIG_FILE=/etc/fonts/fonts.conf
    if [ ! -f ~/.vnc/passwd ]; then
        passwd-kex
    fi
    USR=\$(whoami)
    if [ \$USR == "root" ]; then
        SCREEN=":2"
    else
        SCREEN=":1"
    fi 
    export MOZ_FAKE_NO_SANDBOX=1
    export ELECTRON_DISABLE_SANDBOX=1
    export HOME=\${HOME}
    export USER=\${USR}
    
    LIBGCC_PATH=""
    if [ -f "/usr/lib/aarch64-linux-gnu/libgcc_s.so.1" ]; then
        LIBGCC_PATH="/usr/lib/aarch64-linux-gnu/libgcc_s.so.1"
    elif [ -f "/usr/lib/arm-linux-gnueabihf/libgcc_s.so.1" ]; then
        LIBGCC_PATH="/usr/lib/arm-linux-gnueabihf/libgcc_s.so.1"
    elif [ -f "/usr/lib/libgcc_s.so.1" ]; then
        LIBGCC_PATH="/usr/lib/libgcc_s.so.1"
    fi
    
    if [ -n "\$LIBGCC_PATH" ]; then
        LD_PRELOAD="\$LIBGCC_PATH" nohup vncserver \$SCREEN >/dev/null 2>&1 </dev/null
    else
        nohup vncserver \$SCREEN >/dev/null 2>&1 </dev/null
    fi
    
    starting_kex=1
    return 0
}
function stop-kex() {
    rm -rf /tmp/.X*-lock
    rm -rf /tmp/.X11-unix/X*
    vncserver -kill :1 >/dev/null 2>&1
    vncserver -kill :2 >/dev/null 2>&1
}
function passwd-kex() {
    vncpasswd
    return $?
}
function status-kex() {
    sessions=\$(vncserver -list | sed s/"TigerVNC"/"NetHunter KeX"/)
    if [[ \$sessions == *"590"* ]]; then
        printf "\n\${sessions}\n"
        printf "\n${STR_KEX_CONNECT_HINT}\n\n"
    else
        if [ ! -z \$starting_kex ]; then
            printf "\n%b\n\n" "${STR_KEX_START_ERROR}"
        fi
    fi
    return 0
}
function kill-kex() {
    pkill Xtigervnc
    return \$?
}
case \$1 in
    start)
        start-kex
        ;;
    stop)
        stop-kex
        ;;
    status)
        status-kex
        ;;
    passwd)
        passwd-kex
        ;;
    kill)
        kill-kex
        ;;
    *)
        stop-kex
        sleep 1
        start-kex
        status-kex
        ;;
esac
EOF
    chmod 700 $KEX_LAUNCHER
    log "SUCCESS" "${STR_KEX_COMPLETE}"
}

function fix_profile_bash() {
    log "INFO" "${STR_BASH_PROFILE}"
    if [ -f ${CHROOT}/root/.bash_profile ]; then
        sed -i '/if/,/fi/d' "${CHROOT}/root/.bash_profile"
    fi
}

function fix_resolv_conf() {
    log "INFO" "${STR_DNS_CONFIG}"
    resolv_conf="$CHROOT/etc/resolv.conf"
    cat > "$resolv_conf" <<EOF
nameserver 114.114.114.114
nameserver 8.8.8.8
nameserver 240c::6666
nameserver 240c::6644
EOF
    log "SUCCESS" "${STR_DNS_COMPLETE}"
}

function fix_sudo() {
    log "INFO" "${STR_SUDO_CONFIG}"
    
    chmod +s "$CHROOT/usr/bin/sudo" || log "WARN" "${STR_SW}"
    chmod +s "$CHROOT/usr/bin/su" || log "WARN" "${STR_AW}"
    echo "kali    ALL=(ALL:ALL) ALL" > $CHROOT/etc/sudoers.d/kali
    echo "Set disable_coredump false" > $CHROOT/etc/sudo.conf
    
    log "SUCCESS" "${STR_SUDO_COMPLETE}"
}

function fix_uid() {
    log "INFO" "${STR_UID_FIX}"
    
    USRID=$(id -u)
    GRPID=$(id -g)
    nh -r usermod -u "$USRID" kali 2>/dev/null || log "WARN" "${STR_LZ}"
    nh -r groupmod -g "$GRPID" kali 2>/dev/null || log "WARN" "${STR_SD}" 
    log "SUCCESS" "${STR_UID_COMPLETE}"
}

function update_sources_list() {
    log "INFO" "${STR_MIRROR_UPDATING}"
    
    sources_list="$CHROOT/etc/apt/sources.list"
    if [ -f "$sources_list" ]; then
        cp "$sources_list" "$sources_list.backup"
        rm -rf "$sources_list.backup"
        
        cat > "$sources_list" <<- EOF
deb https://mirrors.tuna.tsinghua.edu.cn/kali kali-rolling main non-free contrib non-free-firmware
deb-src https://mirrors.tuna.tsinghua.edu.cn/kali kali-rolling main non-free contrib non-free-firmware
EOF
        log "SUCCESS" "${STR_SWITCH_MIRROR_SUCCESS}"
        
    fi
}


function print_banner() {
    clear
    printf "${blue}##################################################${reset}\n"
    printf "${blue}##                                              ##${reset}\n"
    printf "${blue}##  88      a8P         db        88        88  ##${reset}\n"
    printf "${blue}##  88    .88'         d88b       88        88  ##${reset}\n"
    printf "${blue}##  88   88'          d8''8b      88        88  ##${reset}\n"
    printf "${blue}##  88 d88           d8'  '8b     88        88  ##${reset}\n"
    printf "${blue}##  8888'88.        d8YaaaaY8b    88        88  ##${reset}\n"
    printf "${blue}##  88P   Y8b      d8''''''''8b   88        88  ##${reset}\n"
    printf "${blue}##  88     '88.   d8'        '8b  88        88  ##${reset}\n"
    printf "${blue}##  88       Y8b d8'          '8b 888888888 88  ##${reset}\n"
    printf "${blue}##                                              ##${reset}\n"
    printf "${blue}################# Kali NetHunter #################${reset}\n"
    if [[ "$LANG" == "en" ]]; then
        printf "${blue}Author：${SUTIN} ${reset}\n"
        printf "${blue}Version：${VERSION} ${reset}\n"
        printf "${blue}Support：${JSZC} ${reset}\n"
    else
        printf "${blue}作者：${SUTIN} ${reset}\n"
        printf "${blue}版本：${VERSION} ${reset}\n"
        printf "${blue}技术支持：${JSZC} ${reset}\n"
    fi
    printf "\n"
    printf "${yellow}${DISCLAIMER_TITLE}${reset}\n"
    printf "${blue}──────────────────────────────────────────────${reset}\n"
    printf "${red}${DISCLAIMER_1}${reset}\n"
    printf "${red}${DISCLAIMER_2}${reset}\n"
    printf "${red}${DISCLAIMER_3}${reset}\n"
    printf "${red}${DISCLAIMER_4}${reset}\n"
    printf "${red}${DISCLAIMER_5}${reset}\n\n"
}


